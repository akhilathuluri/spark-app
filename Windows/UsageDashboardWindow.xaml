<Window x:Class="Spark.Windows.UsageDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spark Usage Dashboard"
        Width="700" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.CacheMode>
        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/>
    </Window.CacheMode>

    <Window.Resources>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C8CB8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECECFF"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C6AF7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E34"/>
            <Setter Property="Foreground" Value="#8D8DCD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202033"/>
            <Setter Property="Foreground" Value="#CFCFF2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#2A2A42"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DashboardGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#DCDCF4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#24243A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="DashboardGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#141420"/>
            <Setter Property="Foreground" Value="#DCDCF4"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#171728"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#23233A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D2D48"/>
                    <Setter Property="Foreground" Value="#F2F2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecentListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#B8B8DA"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#212135"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2C2C46"/>
                    <Setter Property="Foreground" Value="#EFEFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#16161E"
            CornerRadius="14"
            Opacity="0"
            RenderTransformOrigin="0.5,0">

        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleT" ScaleX="0.95" ScaleY="0.95"/>
                <TranslateTransform x:Name="TranslateT" Y="-10"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,15,14,10" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleIconText" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#7C6AF7" Margin="0,0,8,0"/>
                        <TextBlock Text="Usage Dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#E0E0F0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#5A5A7A" FontSize="14" Cursor="Hand"
                            Width="28" Height="28"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,0">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MONTHLY RUNS" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="TotalRunsText" Text="0" Style="{StaticResource CardValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="AVG LATENCY" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="AvgLatencyText" Text="0 ms" Style="{StaticResource CardValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="EST. TOKENS" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="TotalTokensText" Text="0" Style="{StaticResource CardValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A28" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="EST. COST (USD)" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="MonthlyCostText" Text="$0.00" Style="{StaticResource CardValueStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="#1A1A28" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PER ACTION (CURRENT MONTH)" Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid x:Name="ActionsGrid"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="True"
                                      SelectionMode="Single"
                                      IsReadOnly="True"
                                      Background="#141420"
                                      BorderBrush="#2A2A42"
                                      BorderThickness="1"
                                      GridLinesVisibility="None"
                                      RowBackground="#141420"
                                      AlternatingRowBackground="#171728"
                                      AlternationCount="2"
                                      Foreground="#DCDCF4"
                                      HorizontalGridLinesBrush="#24243A"
                                      VerticalGridLinesBrush="#24243A"
                                      RowHeaderWidth="0"
                                      RowStyle="{StaticResource DashboardGridRowStyle}"
                                      CellStyle="{StaticResource DashboardGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource DashboardGridHeaderStyle}"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      MaxHeight="220"
                                      ColumnHeaderHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Action" Binding="{Binding ActionName}" Width="*"/>
                                    <DataGridTextColumn Header="Runs" Binding="{Binding RunCount}" Width="70"/>
                                    <DataGridTextColumn Header="Avg Latency" Binding="{Binding AvgLatencyMs, StringFormat={}{0} ms}" Width="100"/>
                                    <DataGridTextColumn Header="Tokens" Binding="{Binding TotalEstimatedTokens}" Width="90"/>
                                    <DataGridTextColumn Header="Cost (USD)" Binding="{Binding TotalEstimatedCostUsd, StringFormat={}{0:F4}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="#1A1A28" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox x:Name="RecentList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#B8B8DA"
                                     ItemContainerStyle="{StaticResource RecentListItemStyle}"
                                     MaxHeight="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,12,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HintText" Text="Token and cost are estimates for visibility, not billing-accurate provider totals." FontSize="11" Foreground="#4A4A72" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click"/>
                    <Button Grid.Column="3" Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
