<Window x:Class="Spark.Windows.InternetSearchResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internet Search Results"
        Width="580"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.CacheMode>
        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/>
    </Window.CacheMode>

    <Border x:Name="RootBorder"
            Background="#16161E"
            CornerRadius="16"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleT" ScaleX="0.94" ScaleY="0.94"/>
                <TranslateTransform x:Name="TranslateT" Y="-10"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,16,16,16" Background="#1A1A28" CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ActionIcon" Text="" FontSize="24"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                               Foreground="#7C6AF7" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ActionTitle" Text="Internet Search" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#E0E0F0"/>
                        <TextBlock x:Name="QueryText" Text="" FontSize="12"
                                   Foreground="#8080A8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#5A5A7A" FontSize="16" Cursor="Hand"
                            Width="32" Height="32" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Thinking Panel -->
            <Grid x:Name="ThinkingPanel" Grid.Row="1" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Fill="#7C6AF7" Margin="0,0,6,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotT1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#7C6AF7" Margin="0,0,6,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotT2"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#7C6AF7">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="DotT3"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                    <TextBlock Text="Searching the web..." FontSize="14" Foreground="#9090B0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Results Panel -->
            <ScrollViewer x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                <StackPanel>
                    <!-- AI Answer Card -->
                    <Border x:Name="AnswerCard" Background="#1E1E2E" CornerRadius="12"
                            Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="AiAnswerIcon" Text="" FontSize="16" Margin="0,0,8,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                           Foreground="#7C6AF7"/>
                                <TextBlock Text="AI Answer" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#7C6AF7" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="AnswerText" Grid.Row="1" Text="" FontSize="13"
                                       Foreground="#D0D0E8" TextWrapping="Wrap" LineHeight="20"/>
                        </Grid>
                    </Border>

                    <!-- Search Results Header -->
                    <StackPanel x:Name="ResultsHeader" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="SearchResultsIcon" Text="" FontSize="16" Margin="0,0,8,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                   Foreground="#7C6AF7"/>
                        <TextBlock Text="Search Results" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#7C6AF7" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Results List -->
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E2E" CornerRadius="12" Padding="16"
                                        Margin="0,0,0,12" Cursor="Hand"
                                        MouseEnter="ResultCard_MouseEnter"
                                        MouseLeave="ResultCard_MouseLeave"
                                        MouseLeftButtonUp="ResultCard_Click"
                                        Tag="{Binding Url}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#E0E0F0"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- URL -->
                                        <TextBlock Grid.Row="1" Text="{Binding Url}" FontSize="11"
                                                   Foreground="#6C8AF7" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"/>

                                        <!-- Content Snippet -->
                                        <TextBlock Grid.Row="2" Text="{Binding ContentSnippet}" FontSize="12"
                                                   Foreground="#9090B0" TextWrapping="Wrap"
                                                   LineHeight="18" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Error Panel -->
            <Grid x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <TextBlock Text="⚠" FontSize="48" Foreground="#FF6B6B"
                               HorizontalAlignment="Center" Margin="0,0,0,16"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI Emoji, Segoe UI"/>
                    <TextBlock x:Name="ErrorText" Text="" FontSize="13" Foreground="#D0D0E8"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                </StackPanel>
            </Grid>

            <!-- Footer Buttons -->
            <Border x:Name="ButtonPanel" Grid.Row="2" Padding="20,12,20,16"
                    Background="#1A1A28" CornerRadius="0,0,16,16" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResultCountLabel" Text="" FontSize="12"
                               Foreground="#7070A0" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="Close" Click="CloseButton_Click"
                            Background="#5A4AF7" Foreground="White"
                            FontSize="13" FontWeight="Medium" Padding="20,8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#6B5AF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
